{
  "manifest_version": 3,
  "name": "ஆதி மொய் (Aathi Moi) - Offline Chromebook App",
  "version": "1.0.3",
  "description": "Aadhi Moi Collection & Management Software - 100% Offline Chromebook Edition",
  "icons": {
    "16": "assets/icon-16.png",
    "32": "assets/icon-32.png",
    "48": "assets/icon-48.png",
    "128": "assets/icon-128.png"
  },
  "action": {
    "default_title": "Launch ஆதி மொய் (Aathi Moi)",
    "default_icon": {
      "16": "assets/icon-16.png",
      "32": "assets/icon-32.png",
      "48": "assets/icon-48.png",
      "128": "assets/icon-128.png"
    }
  },
  "options_page": "index.html",
  "background": {
    "service_worker": "background.js"
  },
  "permissions": [
    "storage",
    "unlimitedStorage"
  ]
}
